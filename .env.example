# Copy to .env to override defaults
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:9b
# Context window. 8192 suits a 4 GB GPU; use 16384+ on bigger hardware for larger logs.
OLLAMA_NUM_CTX=8192
# Max seconds between streamed chunks (not total runtime)
OLLAMA_TIMEOUT=180
OLLAMA_TEMPERATURE=0
OLLAMA_SEED=42
